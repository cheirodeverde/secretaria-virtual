# ===== Geral =====
PORT=3000
# URL pública com HTTPS (webhook do WhatsApp, login do Google e links mágicos)
BASE_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo
NODE_ENV=production
# 32+ caracteres aleatórios: assina sessões e criptografa tokens do Google. NÃO perca (perder = clientes reconectam o Google)
APP_SECRET=
# Senha do painel /admin (usuário: qualquer)
ADMIN_PASSWORD=
DB_FILE=data/secretaria.db
PRODUCT_NAME=Secretária de Bolso
TRIAL_DAYS=14
GRACE_DAYS=3
PRICE_ESSENCIAL=49
PRICE_PROFISSIONAL=89
# Custo estimado por mensagem (R$) para o painel admin
COST_PER_MESSAGE_BRL=0.035
# true = agenda fictícia (testar sem Google)
DEMO_MODE=false

# ===== Google Agenda (console.cloud.google.com) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional — padrão: BASE_URL/auth/google/callback
GOOGLE_REDIRECT_URI=

# ===== WhatsApp Cloud API (developers.facebook.com) =====
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ID da conta do WhatsApp Business (só para npm run criar-templates)
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-secreto
# Número público da Secretária (link wa.me do site), só dígitos com DDI
WHATSAPP_DISPLAY_NUMBER=5511900000000
WHATSAPP_TEMPLATE_LANG=pt_BR
# true = não envia nada; mensagens vão para o simulador do /admin (ativa sozinho se WHATSAPP_TOKEN estiver vazio)
WHATSAPP_DRY_RUN=false

# ===== Cobrança (Asaas) =====
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
# Token (32+ caracteres) configurado no webhook do Asaas → chega no header asaas-access-token
ASAAS_WEBHOOK_TOKEN=

SYNC_EVERY_MINUTES=5
