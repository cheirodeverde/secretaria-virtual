# ===== Geral =====
PORT=3000
# URL pública com HTTPS (webhook do WhatsApp, login do Google e links mágicos)
BASE_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo
NODE_ENV=production
# 32+ caracteres aleatórios: assina sessões e criptografa tokens do Google. NÃO perca (perder = clientes reconectam o Google)
APP_SECRET=
# Senha do painel /admin (usuário: qualquer)
ADMIN_PASSWORD=
DB_FILE=data/secretaria.db
PRODUCT_NAME=Secretária de Bolso
TRIAL_DAYS=14
GRACE_DAYS=3
PRICE_ESSENCIAL=49
PRICE_PROFISSIONAL=89
# Custo estimado por mensagem (R$) para o painel admin (Evolution: 0 · Meta: ~0.035)
COST_PER_MESSAGE_BRL=0
# true = agenda fictícia (testar sem Google)
DEMO_MODE=false

# ===== Google Agenda (console.cloud.google.com) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional — padrão: BASE_URL/auth/google/callback
GOOGLE_REDIRECT_URI=
# true = a Secretária cria, remarca e cancela compromissos (escopo calendar.events). false = só leitura.
CALENDAR_WRITE=true

# ===== WhatsApp =====
# evolution (padrão) = Evolution API, conectada por QR Code no /admin · meta = API oficial (WhatsApp Cloud)
WHATSAPP_PROVIDER=evolution
# Os NÚMEROS da Secretária são cadastrados no /admin → "Números da Secretária" (URL, chave e instância de cada um).
# As chaves ficam criptografadas no banco — não precisam estar aqui.
# Sem nenhum número ativo = modo simulação (use o simulador do /admin).
#
# Opcional: um primeiro número vindo daqui (é importado para o cadastro na 1ª vez que o sistema sobe).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=secretaria
# Opcional: endereço-base do webhook visto pela Evolution, se diferente de BASE_URL/webhook/evolution
# (ex.: rede interna do Docker). O sistema acrescenta /<id do número>.
EVOLUTION_WEBHOOK_URL=
# Número público (link wa.me do site), se o número padrão do /admin não tiver um cadastrado
WHATSAPP_DISPLAY_NUMBER=5511900000000
# true = não envia nada; mensagens vão para o simulador do /admin
WHATSAPP_DRY_RUN=false

# --- Só para WHATSAPP_PROVIDER=meta (API oficial) ---
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=troque-por-um-texto-secreto
WHATSAPP_TEMPLATE_LANG=pt_BR

# ===== Só para o docker-compose.yml (servidor próprio) =====
# Domínio que aponta para o servidor (HTTPS automático)
DOMAIN=secretaria.seudominio.com.br
# Senha do banco da Evolution
POSTGRES_PASSWORD=

# ===== Cobrança (Asaas) =====
ASAAS_API_KEY=
# sandbox | production
ASAAS_ENV=sandbox
# Token (32+ caracteres) configurado no webhook do Asaas → chega no header asaas-access-token
ASAAS_WEBHOOK_TOKEN=

SYNC_EVERY_MINUTES=5
