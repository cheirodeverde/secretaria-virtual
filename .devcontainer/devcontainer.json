{
  "name": "Secretária de Bolso (demonstração)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm install",
  "postAttachCommand": {
    "servidor": "npm run demo"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Secretária de Bolso", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "settings": { "workbench.startupEditor": "none" } }
  }
}
